# Neon Postgres connection string — from https://console.neon.tech (Project → Connect)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth base URL — from the Neon Console (Project → Auth), e.g.
# https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_URL=

# Origin allowed by CORS (the web app)
WEB_ORIGIN=http://localhost:3000
