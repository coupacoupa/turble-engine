{
  "name": "@turble/engine",
  "version": "0.1.0",
  "description": "Custom 2D Matrix Decision Engine with sequential step flow, parallel row execution, custom table evaluation, global interceptors, and time-travel replay.",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
